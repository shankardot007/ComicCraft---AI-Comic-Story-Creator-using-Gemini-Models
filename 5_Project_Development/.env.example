# REQUIRED — Google Gemini API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OPTIONAL — Hugging Face token for Stable Diffusion image generation.
# Leave empty to have images generated by Gemini's image model instead.
# Set an Inference permission token at https://huggingface.co/settings/tokens
HF_API_KEY=

# Gemini models (configurable)
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Stable Diffusion model used when HF_API_KEY is present
SD_MODEL=stabilityai/stable-diffusion-xl-base-1.0